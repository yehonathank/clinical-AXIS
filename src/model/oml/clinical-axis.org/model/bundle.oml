    includes <http://clinical-axis.org/model/stakeholders#>
    includes <http://clinical-axis.org/model/stages#>
    includes <http://clinical-axis.org/model/components#>
    includes <http://clinical-axis.org/model/artifacts#>
    includes <http://clinical-axis.org/model/assemblies#>
}